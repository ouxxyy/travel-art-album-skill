{
  "name": "travel-art-album-skill",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Reference-image art workflow and single-file offline flipbook skill prototype",
  "scripts": {
    "build:prototype": "node scripts/build-prototype.mjs",
    "check": "node scripts/check-project.mjs",
    "capture:prototype": "node scripts/capture-prototype.mjs",
    "test": "npm run build:prototype && node --test tests/*.test.mjs && node tests/prototype-smoke.mjs",
    "validate:example": "node scripts/validate-manifest.mjs examples/mixed-style-manifest.json",
    "validate:manifest": "node scripts/validate-manifest.mjs",
    "validate:batch-ready": "node scripts/validate-manifest.mjs --batch-ready",
    "sync:skill": "node scripts/sync-skill.mjs",
    "check:skill": "node scripts/sync-skill.mjs --check"
  },
  "dependencies": {
    "page-flip": "2.0.7",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.9",
    "playwright-core": "^1.63.0"
  }
}
